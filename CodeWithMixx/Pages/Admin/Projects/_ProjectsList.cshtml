@using CodeWithMixx.Common.Results
@using CodeWithMixx.Domain.Entities.Projects
@using CodeWithMixx.Domain.Entities.Reservations
@model PagedResult<ProjectReservationListItem>

@if (!Model.Items.Any())
{
    <div class="flex flex-col items-center justify-center py-20 px-5 text-center">
        <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-500/10">
            <i class="fa-solid fa-folder-open text-4xl text-emerald-500/40"></i>
        </div>
        <h4 class="text-xl font-semibold text-white">Nema rezultata</h4>
        <p class="mt-2 text-sm text-emerald-300/60 max-w-xs">
            Podaci sa unetim kriterijumima nisu pronađeni. Pokušajte sa drugim parametrima filtera.
        </p>
    </div>
}
else
{
    <div class="grid gap-4 px-5 pb-5 sm:grid-cols-2 lg:grid-cols-2 sm:px-6">
        @foreach (var project in Model.Items)
        {
            <article 
                hx-get="/admin/projects/details/@project.Id"
                hx-swap="innerHTML"
                hx-target="#content"
                hx-push-url="true"
                class="rounded-xl bg-white/5 p-4 shadow-md hover:bg-white/10 transition-all duration-150 flex flex-col justify-between cursor-pointer active:scale-95 active:opacity-70">
                <div class="mb-3 flex justify-between gap-3 items-start">
                    <div>
                        <h4 class="font-semibold text-white">@project.StudentName</h4>
                        <p class="text-xs text-emerald-300/70">@project.SubjectName</p>
                    </div>
                    <div class="flex justify-end flex-wrap md:flex-nowrap gap-2 items-center font-semibold text-sm">
                        @switch (project.ProjectStatus)
                        {
                            case ProjectStatus.Ongoing:
                                <p class="text-sky-200 sm:bg-sky-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="hidden sm:inline-block fa-solid fa-hourglass-half mr-2"></i>U toku</p>
                                break;
                            case ProjectStatus.Completed:
                                <p class="text-green-200 sm:bg-green-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-check mr-2"></i>Završen</p>
                                break;
                            case ProjectStatus.Cancelled:
                                <p class="text-red-200 sm:bg-red-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-circle-xmark mr-2"></i>Otkazan</p>
                                break;
                            case ProjectStatus.Standby:
                                <p class="text-amber-200 sm:bg-amber-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-clock mr-2"></i>Na čekanju</p>
                                break;
                        }

                        @switch (project.PaymentStatus)
                        {
                            case PaymentStatus.Pending:
                                <p class="text-amber-200 sm:bg-amber-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-circle-check mr-2"></i>Neplaćeno</p>
                                break;
                            case PaymentStatus.Paid:
                                <p class="text-sky-200 sm:bg-sky-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-circle-check mr-2"></i>Plaćeno</p>
                                break;
                            case PaymentStatus.Overdue:
                                <p class="text-red-200 sm:bg-red-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-circle-exclamation mr-2"></i>Dugovanje</p>
                                break;
                            case PaymentStatus.PartiallyPaid:
                                <p class="text-yellow-200 sm:bg-yellow-900 sm:px-2 sm:py-1 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-circle-half-stroke mr-2"></i>Del. plaćeno</p>
                                break;
                        }
                    </div>
                </div>

                <div class="flex justify-between items-center gap-2 flex-wrap text-sm text-emerald-100/80">
                    <div class="flex flex-col gap-2">
                        <p class="sm:p-2 sm:bg-emerald-900 sm:rounded-md sm:shadow-sm"><i class="fa-regular fa-calendar mr-2 text-emerald-400/80"></i>Rezervisano: @project.ReservedAt</p>
                        <p class="sm:p-2 sm:bg-emerald-900 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-money-bill mr-2 text-emerald-400/80"></i>Cena: @project.TotalPrice</p>
                    </div>
                    <div class="flex flex-col gap-2">
                        <p class="sm:p-2 sm:bg-emerald-900 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-hourglass-start mr-2 text-emerald-400/80"></i>Početak: @project.StartDate</p>
                        <p class="sm:p-2 sm:bg-emerald-900 sm:rounded-md sm:shadow-sm"><i class="fa-solid fa-hourglass-end mr-2 text-emerald-400/80"></i>Kraj: @project.EndDate</p>
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="flex items-center justify-between bg-emerald-900/30 px-5 py-3 sm:px-6">
        <p class="text-xs text-emerald-300/50">Prikazan broj projekata: @Model.PaginatedCount</p>

        <div class="flex gap-2">
            <button hx-push-url="true"
                    hx-get="/admin/projects?handler=Projects&page=@(Model.PageNumber - 1)"
                    hx-target="#projects-list"
                    hx-indicator="#projects-list-indicator"
                    hx-swap="innerHTML"
                    hx-include="[name='filter'], [name='subjectId'], [name='sort']"
                    class="bg-emerald-400 flex items-center justify-center px-4 py-1 rounded-md hover:bg-emerald-500 active:scale-95 disabled:opacity-50 transition duration-200"
                    @(Model.HasPreviousPage ? "" : "disabled")>
                <i class="fa-solid fa-chevron-left text-amber-600"></i>
            </button>
            <div class="bg-emerald-400 px-4 py-1 rounded-md text-amber-600 font-semibold">
                @Model.PageNumber
            </div>

            <button hx-push-url="true"
                    hx-get="/admin/projects?handler=Projects&page=@(Model.PageNumber + 1)"
                    hx-target="#projects-list"
                    hx-indicator="#projects-list-indicator"
                    hx-swap="innerHTML"
                    hx-include="[name='filter'], [name='subjectId'], [name='sort']"
                    class="bg-emerald-400 flex items-center justify-center px-4 py-1 rounded-md hover:bg-emerald-500 active:scale-95 disabled:opacity-50 transition duration-200"
                    @(Model.HasNextPage ? "" : "disabled")>
                <i class="fa-solid fa-chevron-right text-amber-600"></i>
            </button>
        </div>
    </div>
}
